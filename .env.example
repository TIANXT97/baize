# 白泽服务端口
BAIZE_PORT=8767

# LLM 事实提取接口（推荐百灵 Ling-3.0-flash 或兼容 OpenAI 格式端点）
BAIZE_LLM_KEY=your_llm_api_key_here
LLM_API_URL=https://api.ant-ling.com/v1
LLM_MODEL=Ling-3.0-flash

# 向量嵌入接口（支持 Voyage AI 或 SiliconFlow bge-m3）
BAIZE_VOYAGE_KEY=your_voyage_api_key_here
BAIZE_EMBED_KEY=your_siliconflow_api_key_here

# WAL 崩溃重放控制（1=完整重放，0=仅审计）
BAIZE_WAL_REPLAY=1
